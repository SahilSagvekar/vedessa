# Copy to .env.local (dev) or set in Vercel -> Project Settings -> Environment Variables.
# Firebase web config: Firebase console -> Project settings -> General -> Your apps -> Web app.
# These values are public identifiers (they ship in the browser bundle), but keep real ones out of git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

VITE_API_URL=http://localhost:5000/api
